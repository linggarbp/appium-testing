# ── Appium endpoint ───────────────────────────────────────────────────────────
# The Appium 3 server the suite connects to (local, containerized, or a device farm).
APPIUM_SERVER_URL=http://127.0.0.1:4723
# WebDriver base path — only change it when Appium sits behind a URL prefix.
APPIUM_PATH=/

# ── Device selection ──────────────────────────────────────────────────────────
PLATFORM_NAME=Android
# Blank means "let Appium decide" — fine on single-device machines.
PLATFORM_VERSION=
DEVICE_NAME=
AUTOMATION_NAME=UiAutomator2
# Target a specific device when several are attached (`adb devices`).
UDID=

# ── App under test (Swag Labs, the public Sauce Labs demo shop) ───────────────
APPIUM_APP_PACKAGE=com.swaglabsmobileapp
APPIUM_APP_ACTIVITY=.MainActivity
# Optional local .apk — same-host Appium only. Wins over APPIUM_APP_URL when the file exists.
APPIUM_APP_PATH=
# Optional remote .apk — Appium downloads and installs it on the first session of a run.
APPIUM_APP_URL=

# ── Session tuning ────────────────────────────────────────────────────────────
NEW_COMMAND_TIMEOUT=120
IMPLICIT_TIMEOUT_MS=5000

# ── Public demo credentials of the Swag Labs sample app ───────────────────────
TEST_USERNAME=standard_user
TEST_PASSWORD=secret_sauce

# ── Artifacts ─────────────────────────────────────────────────────────────────
ARTIFACTS_DIR=test-results
